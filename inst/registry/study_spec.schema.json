{
  "version": "0.4.0",
  "description": "Minimal StudySpec contract. Fields under 'consequential' must be set (or explicitly marked as an assumption) before a design is final. system is the setting the experimental units live in; study_type the kind of study; assays the measurements.",
  "consequential": [
    "system",
    "goal",
    "primary_outcome.name",
    "primary_outcome.type",
    "experimental_unit",
    "factors",
    "design.candidates",
    "power.minimum_detectable_difference",
    "power.residual_sd"
  ],
  "optional": [
    "study_type",
    "organism",
    "measurement_unit",
    "subsamples_per_unit",
    "blocking_factors",
    "design.reps",
    "design.locations",
    "design.seasons",
    "power.alpha",
    "power.target_power",
    "power.attrition",
    "constraints.max_units",
    "constraints.budget",
    "population.type",
    "population.parents",
    "population.generations",
    "population.mating",
    "assays",
    "organisms",
    "environments",
    "population.filial_generation"
  ],
  "enums": {
    "system": [
      "field",
      "greenhouse",
      "growth_chamber",
      "mouse",
      "livestock",
      "drosophila",
      "cell_culture"
    ],
    "primary_outcome.type": [
      "continuous",
      "binary",
      "count",
      "ordinal",
      "survival",
      "compositional"
    ],
    "status": [
      "needs_clarification",
      "assumptions_flagged",
      "validated"
    ],
    "study_type": [
      "breeding_genetics",
      "multi_environment",
      "multi_omics",
      "functional_validation"
    ]
  }
}

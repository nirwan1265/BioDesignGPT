{"id": "f2_01", "prompt": "We crossed BTx623 with a sweet sorghum and plan to advance 250 RILs by single seed descent to the F6. How should we phenotype them?", "expected_spec": {"organism": "Sorghum bicolor", "factors": [{"name": "genotype", "n_levels": 250}], "population": {"mating": "selfing", "filial_generation": 6}, "study_type": "breeding_genetics"}, "must_ask": ["primary_outcome.name"]}
{"id": "f2_02", "prompt": "Our new knockout mouse line has been kept by brother-sister mating for 8 generations. Can we treat it as inbred?", "expected_spec": {"system": "mouse", "organism": "Mus musculus", "population": {"mating": "sib_mating", "generations": 8}, "study_type": "breeding_genetics"}, "must_ask": ["design.reps"]}
